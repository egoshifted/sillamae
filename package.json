{
  "name": "sillamae",
  "description": "An interactive 3D model of Sillamäe, Estonia. The town model is being progressively refined against reference imagery; detail varies between buildings.",
  "scripts": {
    "data": "node --max-old-space-size=8192 pipeline/build.ts",
    "osm": "node pipeline/fetch-osm.ts",
    "assets:check": "node src/studio/tools/assets.ts",
    "assets:preview": "node src/studio/tools/asset-preview.ts",
    "roads:check": "node --max-old-space-size=8192 pipeline/check-roads.ts",
    "dev": "node --max-old-space-size=8192 pipeline/build.ts && vite",
    "check": "tsc -p .",
    "test": "node --test \"src/**/*.test.ts\"",
    "build": "tsc -p . && node --max-old-space-size=8192 pipeline/build.ts && vite build",
    "preview": "vite preview",
    "dtm": "node pipeline/fetch-dtm.ts",
    "studio": "node --max-old-space-size=8192 pipeline/build.ts && vite --host 127.0.0.1 --port 5174 --strictPort --open /src/studio/",
    "studio:check": "node src/studio/tools/verify.ts",
    "studio:snapshot": "node src/studio/tools/snapshot.ts",
    "studio:capture": "node src/studio/tools/capture.ts",
    "studio:evidence": "node src/studio/tools/evidence.ts",
    "studio:finalize": "node src/studio/tools/finalize.ts",
    "studio:new": "node src/studio/tools/new.ts"
  },
  "type": "module",
  "dependencies": {
    "meshoptimizer": "1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.1.2",
    "clipper-lib": "6.4.2",
    "geotiff": "3.0.5",
    "osm2streets-js": "0.1.4",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "private": true
}
